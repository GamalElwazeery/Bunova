# Bunova Operational Platform - Environment Configuration Template
# This file is secret-safe. NEVER commit live credentials or production secrets here.

# --- Application & Localization ---
APP_NAME=Bunova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Bilingual defaults: Arabic primary operational language, English fallback
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# --- Logging & Observability ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Primary Operational Database ---
# Local dev defaults to SQLite; production/staging uses PostgreSQL
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=bunova
# DB_USERNAME=bunova
# DB_PASSWORD=

# --- Session & Security ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# --- Caching, Queues & Realtime ---
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis (Required for Production/Staging Cache & Queues) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Laravel Reverb (Realtime WebSocket Layer) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME="http"

# --- Mail & Outbound Notifications ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bunova.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object Storage (MinIO / S3 for media & receipts) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=bunova-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Bunova Security Tokens & Platform Primitives ---
# Secret used for HMAC signing of registered device tokens
BUNOVA_DEVICE_TOKEN_SECRET=
# Secret used for Platform Admin session validation
BUNOVA_PLATFORM_OPERATOR_SECRET=
