{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elwazeery.github.io/ai-executionkit/task-projection-v2.json",
  "title": "AI ExecutionKit native task projection",
  "type": "object",
  "required": ["schemaVersion", "sources", "tasks"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "sourcePath", "order"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "sourcePath": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0},
          "isArchive": {"type": "boolean"},
          "title": {"type": ["string", "null"]},
          "objective": {"type": ["string", "null"]},
          "phase": {"type": ["string", "null"]},
          "priority": {"type": ["string", "null"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "action": {"enum": ["audit"]},
          "auditBoundary": {"enum": ["ad-hoc", "wave", "phase", "release"]},
          "contract": {"type": ["string", "null"]},
          "verification": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]},
          "blocker": {"type": ["string", "null"]},
          "blockerActionable": {"type": "boolean"},
          "unblockAction": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "risk": {"type": "string"}
        },
        "dependentRequired": {"auditBoundary": ["action"]},
        "allOf": [
          {
            "if": {"properties": {"action": {"const": "audit"}}, "required": ["action"]},
            "then": {"required": ["auditBoundary"]}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
