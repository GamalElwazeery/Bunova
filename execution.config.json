{
  "$schema": "./.executionkit/runtime/AI-ExecutionKit/schemas/execution-config.schema.json",
  "standardVersion": "3.0.0",
  "projectState": "BOOTSTRAP",
  "profile": "FULL",
  "customRationale": "Bunova is a multi-surface cafe operations SaaS with financial, offline, fiscal, public-web, Flutter and premium UI requirements; SEO is bounded to public acquisition surfaces.",
  "capabilities": {
    "execution": "FULL",
    "agent": "FULL",
    "content": "FULL",
    "seo": "STANDARD",
    "audit": "FULL",
    "test": "FULL",
    "launch": "FULL"
  },
  "ci": {
    "provider": "github-actions",
    "executionMode": "self-hosted-manual",
    "githubHostedAllowed": false,
    "automaticPushRuns": false,
    "allowedAutomaticWorkflowPaths": [],
    "projectRunnerLabel": "project-bunova",
    "maxProjectRunnersPerDevice": 1,
    "allowedRunnerOS": ["macOS", "windows"]
  },
  "agent": {"manifestPath": ".agents/manifest.json"},
  "operator": {
    "entrypoint": "todo-first",
    "additionalBootstrapPromptRequired": false,
    "hostChecklistMode": "derived-mirror",
    "syncHostChecklistAfterTask": true,
    "fullCiCadence": "phase-boundary",
    "targetedTaskVerification": true,
    "hostPersistenceAuthority": "none"
  },
  "runtime": {
    "mode": "SEQUENTIAL",
    "oneLifecycleActionAtATime": true,
    "allowBoundedHostDelegation": true,
    "checkpointPath": ".executionkit/runtime/checkpoint.json"
  },
  "state": {
    "enabled": true,
    "snapshotPath": ".executionkit/state/latest.json",
    "journalPath": ".executionkit/state/journal.ndjson",
    "checkpointOnRuntimeTransitions": true,
    "requireRehydrateOnDrift": true,
    "heartbeatMinutes": 20,
    "memory": {
      "mode": "auto",
      "authority": "advisory",
      "requireLiveRevalidation": true,
      "allowTaskState": false
    }
  },
  "fleet": {
    "enabled": true,
    "agentMode": "per-device",
    "hostActivity": "local-pulse",
    "remoteControl": "disabled",
    "telemetry": {
      "transport": "local-agent",
      "authority": "observational",
      "uploadTodoContent": false,
      "uploadSourceContent": false,
      "shareLocalPaths": false
    }
  },
  "discovery": {
    "enabled": true,
    "scopePath": "executionkit.scope.json",
    "inventoryPath": ".executionkit/discovery/product-inventory.json",
    "reconciliationPath": ".executionkit/discovery/reconciliation.json",
    "requiredForRelease": true,
    "failOnDeclaredMissing": true,
    "allowEmptyScopeForRelease": false
  },
  "evidence": {
    "candidateRequiredForRelease": true,
    "adapterConfigPath": "executionkit.adapters.json",
    "maxAgeMinutes": 1440,
    "requiredProducers": [],
    "requireTestAdequacy": false,
    "testReportPath": "",
    "testFormat": "",
    "minimumTests": 0,
    "allowSkipped": false,
    "allowFlaky": false
  },
  "seo": {"contractPath": "executionkit.seo.json", "requiredForRelease": true},
  "premiumExperience": {"applicability": "REQUIRED", "qualityProfile": "premium", "notApplicableReason": ""},
  "quality": {"contractPath": "executionkit.quality.json"},
  "editors": {"antigravity": true},
  "taskModel": {"adapter": "native-markdown", "projectionPath": "", "projectionCommand": ""},
  "adoption": {
    "deepIntegrationRequired": true,
    "integrationPhase": "EK00",
    "integrationGateTaskId": "EK00-AUDIT",
    "integrationActivationTaskId": "EK00-ACTIVATE",
    "productExecutionBlockedUntilGateAccepted": true
  },
  "todoPath": "TODO.md",
  "taskArchivePaths": ["TODO_ARCHIVE.md"],
  "validStates": ["PLANNED", "READY", "BLOCKED", "IN_PROGRESS", "IMPLEMENTED", "REVIEW_REQUIRED", "CORRECTION_REQUIRED", "ACCEPTED", "VERIFIED", "RELEASED", "CANCELLED"],
  "stateAliases": {"VERIFIED": "ACCEPTED"},
  "acceptedStates": ["ACCEPTED", "RELEASED"],
  "verifiedStates": ["ACCEPTED", "VERIFIED", "RELEASED"],
  "terminalStates": ["ACCEPTED", "VERIFIED", "RELEASED", "CANCELLED"],
  "archiveTerminalStates": ["ACCEPTED", "VERIFIED", "RELEASED", "CANCELLED"],
  "dependencySatisfiedStates": ["ACCEPTED", "VERIFIED", "RELEASED"],
  "cancellationSatisfiesDependencies": false,
  "referenceKeys": ["Contract"],
  "scanCompetingBacklogs": true,
  "backlogScanRoots": ["docs", ".agents"],
  "ignoreBacklogPaths": ["docs/reference", "docs/archive"],
  "competingBacklogAsError": true,
  "forbidManualProgressPercentages": true,
  "requireEvidenceForVerified": true,
  "requireContractForReady": false,
  "requireVerificationField": true,
  "requireBlockerForBlocked": true,
  "requireCancellationReason": true,
  "requireExecutorForInProgress": false,
  "validateMarkdownAnchors": true,
  "rejectPlaceholdersWhenActive": true
}
