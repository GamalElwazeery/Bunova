{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://executionkit.local/schemas/agent-telemetry.schema.json",
  "title":"ExecutionKit Agent Telemetry Batch",
  "type":"object",
  "additionalProperties":false,
  "required":["protocolVersion","batchId","device","events"],
  "properties":{
    "protocolVersion":{"const":"1.0.0"},
    "batchId":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "device":{
      "type":"object","additionalProperties":false,
      "required":["deviceId","sessionId","agentVersion","platform","arch"],
      "properties":{
        "deviceId":{"type":"string","format":"uuid"},"sessionId":{"type":"string","format":"uuid"},"agentVersion":{"type":"string","minLength":1},
        "platform":{"type":"string","enum":["win32","darwin","linux"]},"arch":{"type":"string","minLength":1},"hostname":{"type":["string","null"]}
      }
    },
    "events":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/event"}}
  },
  "$defs":{
    "project":{
      "type":"object","additionalProperties":false,"required":["worktreeId","repositoryKey","name"],
      "properties":{
        "worktreeId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"repositoryKey":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
        "name":{"type":"string","minLength":1,"maxLength":200},"localPath":{"type":"string","minLength":1,"maxLength":4096}
      }
    },
    "event":{
      "type":"object","additionalProperties":false,
      "required":["protocolVersion","eventId","sessionId","sequence","deviceId","agentVersion","occurredAt","kind","source","project","payload"],
      "properties":{
        "protocolVersion":{"const":"1.0.0"},"eventId":{"type":"string","format":"uuid"},"sessionId":{"type":"string","format":"uuid"},
        "sequence":{"type":"integer","minimum":1},"deviceId":{"type":"string","format":"uuid"},"agentVersion":{"type":"string","minLength":1},
        "occurredAt":{"type":"string","format":"date-time"},
        "kind":{"type":"string","enum":[
          "agent.hello","agent.heartbeat","agent.goodbye","agent.capabilities","agent.diagnostic",
          "project.discovered","project.host_active","project.host_inactive","project.execution_active","project.execution_inactive","project.git_changed","project.todo_changed_local",
          "state.checkpoint_observed","executionkit.semantic"
        ]},
        "source":{"type":"string","minLength":1,"maxLength":100},"project":{"oneOf":[{"$ref":"#/$defs/project"},{"type":"null"}]},"payload":{"type":"object"}
      }
    }
  }
}
